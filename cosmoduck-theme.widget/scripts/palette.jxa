#!/usr/bin/env osascript -l JavaScript
// Cosmoduck · palette — estrae un accento dal wallpaper.
//
// Uso:  osascript -l JavaScript palette.jxa <file-url-o-path> <blend> <sat-floor> <vividness>
// Stdout: un oggetto JSON di variabili CSS, o niente (exit 1) se l'immagine non
// si apre. Nessuna dipendenza: solo il bridge ObjC di JXA.
//
// Il tema originale e' una sola tinta (~204 deg) campionata a stop fissi di
// saturazione e luminosita' — vedi TEMA qui sotto. Quindi adattarlo al
// wallpaper vuol dire ruotare la tinta e riscalare la saturazione, tenendo la
// luminosita' dov'e': e' la L che decide se il testo si legge sul vetro scuro,
// e quella non la puo' dettare una foto.
//
// L'analisi pero' non si fa in HSL, che mente su entrambe le cose che qui
// contano: i suoi gradi non sono percettivamente uniformi (il giallo occupa una
// fetta strettissima del cerchio, il blu una enorme) e la sua S non dice quanto
// un colore sia carico (un giallo e un blu con la stessa S non lo sono). Si
// legge quindi in Oklab, e solo il risultato torna in HSL per comporre il tema.
ObjC.import('AppKit');
ObjC.import('Quartz');
ObjC.import('stdlib');

// osascript -l JavaScript <script> a b c  ->  argv[0..3] sono l'interprete e i
// suoi flag; gli argomenti nostri cominciano al 4.
var ARGV = ObjC.deepUnwrap($.NSProcessInfo.processInfo.arguments).slice(4);

var SRC       = ARGV[0] || null;
var BLEND     = parseFloat(ARGV[1]); if (isNaN(BLEND))     BLEND = 1.0;
var SAT_FLOOR = parseFloat(ARGV[2]); if (isNaN(SAT_FLOOR)) SAT_FLOOR = 0.75;
var VIVIDNESS = parseFloat(ARGV[3]); if (isNaN(VIVIDNESS)) VIVIDNESS = 1.5;
var TWO_TONE  = (ARGV[4] || '1') !== '0';

var BASE_HUE   = 204;        // la tinta Cosmoduck, usata come ancora e ripiego
var CHROMA_REF = 0.085;      // croma Oklab che vale "scala 1.0": la mediana di
                             // un campione di 476 wallpaper, cosi' la foto
                             // tipica riproduce la saturazione originale
var SAT_CAP    = 1.15;       // quanto puo' spingere un wallpaper molto acceso
var GREY_SAT   = 0.08;       // saturazione, in frazione dell'originale, quando
                             // il wallpaper non ha colore: un bianco e nero
                             // merita un tema in grigi, non un blu inventato
var SIDE       = 96;         // lato del bitmap su cui si misura
var SIDE_HI    = 256;        // e quello per rileggere le macchie di un
                             // wallpaper piatto, dove 96 non basta

// ruolo: [saturazione, luminosita', scarto di tinta] — misurati sui colori
// hardcoded originali, che non sono su una tinta sola: i tre toni scuri stanno
// una decina di gradi piu' in la', ed e' quello scarto a dargli il freddo.
var TEMA = {
  accent: [0.70, 0.63,  0],  // #5DADE2
  bright: [0.70, 0.81,  0],  // #AED6F1
  mid:    [0.70, 0.72,  0],  // #85C1E9
  deep:   [0.61, 0.40,  0],  // #2874A6
  shadow: [0.51, 0.25, 11],  // #1F3A5F
  text:   [0.41, 0.85,  4],  // #C8D9E8
  ink:    [0.39, 0.10, 11],  // #0F1722
  glass:  [0.36, 0.10,  8]   // rgba(16,24,34,.55)
};

function clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }

// ── colore ────────────────────────────────────────────────────────────────────
function rgbToHsl(r, g, b) {
  r /= 255; g /= 255; b /= 255;
  var mx = Math.max(r, g, b), mn = Math.min(r, g, b), l = (mx + mn) / 2, h = 0, s = 0;
  if (mx !== mn) {
    var d = mx - mn;
    s = l > 0.5 ? d / (2 - mx - mn) : d / (mx + mn);
    h = mx === r ? (g - b) / d + (g < b ? 6 : 0) : mx === g ? (b - r) / d + 2 : (r - g) / d + 4;
    h *= 60;
  }
  return [h, s, l];
}

function hslToRgb(h, s, l) {
  h = ((h % 360) + 360) % 360;
  s = clamp(s, 0, 1); l = clamp(l, 0, 1);
  var a = s * Math.min(l, 1 - l);
  var f = function (n) {
    var k = (n + h / 30) % 12;
    return Math.round(255 * (l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1))));
  };
  return [f(0), f(8), f(4)];
}

function srgbToLinear(c) {
  c /= 255;
  return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
}

// sRGB -> Oklab (Björn Ottosson). Ritorna [L, a, b].
function oklab(r, g, b) {
  var R = srgbToLinear(r), G = srgbToLinear(g), B = srgbToLinear(b);
  var l = Math.cbrt(0.4122214708 * R + 0.5363325363 * G + 0.0514459929 * B);
  var m = Math.cbrt(0.2119034982 * R + 0.6806995451 * G + 0.1073969566 * B);
  var s = Math.cbrt(0.0883024619 * R + 0.2817188376 * G + 0.6299787005 * B);
  return [0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
          1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
          0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s];
}

function oklchToSrgb(L, C, hDeg) {
  var h = hDeg * Math.PI / 180, a = C * Math.cos(h), bb = C * Math.sin(h);
  var l = L + 0.3963377774 * a + 0.2158037573 * bb;
  var m = L - 0.1055613458 * a - 0.0638541728 * bb;
  var s = L - 0.0894841775 * a - 1.2914855480 * bb;
  l = l * l * l; m = m * m * m; s = s * s * s;
  var R =  4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s;
  var G = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s;
  var B = -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s;
  var enc = function (u) {
    u = clamp(u, 0, 1);
    return Math.round(255 * (u <= 0.0031308 ? 12.92 * u : 1.055 * Math.pow(u, 1 / 2.4) - 0.055));
  };
  return [enc(R), enc(G), enc(B)];
}

// La tinta percettiva non e' la tinta HSL (fra le due ci sono decine di gradi
// di scarto sui verdi e sui viola): per tornare in HSL si costruisce il colore
// che quella tinta rappresenta e gli si chiede la sua H.
function okHueToHslHue(hue, chroma) {
  var rgb = oklchToSrgb(0.65, Math.min(chroma, 0.12), hue);
  return rgbToHsl(rgb[0], rgb[1], rgb[2])[0];
}

function hex(rgb) {
  return '#' + rgb.map(function (v) { return v.toString(16).padStart(2, '0'); }).join('').toUpperCase();
}
function rgba(rgb, a) { return 'rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',' + a + ')'; }

// In JXA console.log finisce su stderr: Ubersicht legge stdout, quindi il JSON
// va scritto a mano sul file handle giusto.
function emit(handle, text) {
  handle.writeData($.NSString.alloc.initWithUTF8String(text)
    .dataUsingEncoding($.NSUTF8StringEncoding));
}
function out(text) { emit($.NSFileHandle.fileHandleWithStandardOutput, text + '\n'); }
function err(text) { emit($.NSFileHandle.fileHandleWithStandardError, text + '\n'); }

// ── pixel ─────────────────────────────────────────────────────────────────────
var B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
var B64REV = {}; for (var _i = 0; _i < 64; _i++) B64REV[B64[_i]] = _i;

function b64bytes(s) {
  var buf = new Uint8Array(Math.floor(s.length * 3 / 4)), n = 0, acc = 0, bits = 0;
  for (var i = 0; i < s.length; i++) {
    var v = B64REV[s[i]]; if (v === undefined) continue;
    acc = (acc << 6) | v; bits += 6;
    if (bits >= 8) { bits -= 8; buf[n++] = (acc >> bits) & 255; }
  }
  return buf.subarray(0, n);
}
function i32(b, p) { return (b[p] | (b[p+1] << 8) | (b[p+2] << 16) | (b[p+3] << 24)) | 0; }

// Il wallpaper viene ridisegnato in un bitmap piccolo invece che campionato a
// punti: ogni pixel del buffer e' la media dell'area che gli corrisponde,
// quindi nessuna macchia cade fra un campione e l'altro e il rumore di
// compressione si media via. Si passa da Core Graphics perche' NSImage non
// disegna in un contesto che non sia quello corrente.
function loadPixels(src, side) {
  var img = /^file:\/\//.test(src)
    ? $.NSImage.alloc.initWithContentsOfURL($.NSURL.URLWithString(src))
    : $.NSImage.alloc.initWithContentsOfFile(src);
  if (!img || !img.js || !img.isValid) return null;
  var cg = img.CGImageForProposedRectContextHints($(), $(), $());
  if (!cg) return null;
  var rep = $.NSBitmapImageRep.alloc
    .initWithBitmapDataPlanesPixelsWidePixelsHighBitsPerSampleSamplesPerPixelHasAlphaIsPlanarColorSpaceNameBytesPerRowBitsPerPixel(
      $(), side, side, 8, 4, true, false, $.NSCalibratedRGBColorSpace, 0, 0);
  if (!rep || !rep.js) return null;
  var ctx = $.NSGraphicsContext.graphicsContextWithBitmapImageRep(rep);
  if (!ctx || !ctx.js) return null;
  $.CGContextSetInterpolationQuality(ctx.CGContext, 3);           // kCGInterpolationHigh
  $.CGContextDrawImage(ctx.CGContext, $.CGRectMake(0, 0, side, side), cg);
  // I byte del bitmap non si leggono da JXA: bitmapData e' un puntatore grezzo,
  // e darlo in pasto a NSData fa cadere osascript. Si riesporta quindi in BMP,
  // l'unico formato non compresso che NSBitmapImageRep sa scrivere, e lo si
  // rilegge via base64 — un paio di millisecondi a questa dimensione.
  var bmp = rep.representationUsingTypeProperties(1, $());        // 1 = NSBitmapImageFileTypeBMP
  if (!bmp || !bmp.js) return null;
  var b = b64bytes(ObjC.unwrap(bmp.base64EncodedStringWithOptions(0)));
  var off = i32(b, 10), w = i32(b, 18), h = i32(b, 22), bpp = b[28] | (b[29] << 8);
  var topDown = h < 0; h = Math.abs(h);
  if (w <= 0 || h <= 0 || (bpp !== 24 && bpp !== 32)) return null;
  var stride = bpp / 8, rowBytes = Math.floor((bpp * w + 31) / 32) * 4;
  var px = new Uint8Array(w * h * 3);
  for (var y = 0; y < h; y++) {
    var row = off + (topDown ? y : h - 1 - y) * rowBytes, o = y * w * 3;
    for (var x = 0; x < w; x++) {
      var p = row + x * stride;
      px[o + x*3] = b[p+2]; px[o + x*3 + 1] = b[p+1]; px[o + x*3 + 2] = b[p];
    }
  }
  return { w: w, h: h, px: px };
}

// ── accento ───────────────────────────────────────────────────────────────────
var BINS = 72, BINW = 360 / BINS;      // bin da 5 gradi
var KERNEL = [1, 2, 3, 2, 1];          // lisciatura circolare, +-10 gradi

function circMeanDeg(x, y) { var d = Math.atan2(y, x) * 180 / Math.PI; return (d % 360 + 360) % 360; }
function arcDist(a, b) { var d = Math.abs(a - b) % 360; return d > 180 ? 360 - d : d; }
function percentile(pairs, q) {        // pairs: [[valore, peso], ...] gia' ordinate
  var tot = 0, i;
  for (i = 0; i < pairs.length; i++) tot += pairs[i][1];
  if (!tot) return 0;
  var target = tot * q, acc = 0;
  for (i = 0; i < pairs.length; i++) {
    acc += pairs[i][1];
    if (acc >= target) return pairs[i][0];
  }
  return pairs[pairs.length - 1][0];
}

// Raccoglie l'istogramma delle tinte sopra una soglia di croma, piu' R: la
// lunghezza del risultante circolare, cioe' quanto le tinte dell'immagine
// concordano fra loro. R vicino a 1 vuol dire che tutti i pixel colorati
// puntano nella stessa direzione; R basso, che sono sparpagliati.
function collect(px, W, H, cmin) {
  var L_MIN = 0.12, L_MAX = 0.97;
  var mass = new Array(BINS).fill(0), sx = new Array(BINS).fill(0), sy = new Array(BINS).fill(0);
  var hues = [], chromas = [], total = 0, kept = 0, seen = 0, gx = 0, gy = 0;
  for (var y = 0; y < H; y++) for (var x = 0; x < W; x++) {
    var p = (y * W + x) * 3, lab = oklab(px[p], px[p+1], px[p+2]);
    seen++;
    var C = Math.sqrt(lab[1]*lab[1] + lab[2]*lab[2]);
    if (lab[0] < L_MIN || lab[0] > L_MAX || C < cmin) continue;
    var h = circMeanDeg(lab[1], lab[2]), w = C * C, hr = h * Math.PI / 180;
    kept++; total += w; hues.push(h); chromas.push(C);
    gx += Math.cos(hr) * w; gy += Math.sin(hr) * w;
    // deposito lineare sui due bin adiacenti: una massa a cavallo di un confine
    // non si spacca piu' in due meta' che perdono tutte e due.
    var pos = h / BINW - 0.5, k0 = Math.floor(pos), f = pos - k0;
    var ka = (k0 % BINS + BINS) % BINS, kb = (ka + 1) % BINS;
    mass[ka] += w * (1 - f); mass[kb] += w * f;
    sx[ka] += Math.cos(hr) * w * (1 - f); sy[ka] += Math.sin(hr) * w * (1 - f);
    sx[kb] += Math.cos(hr) * w * f;       sy[kb] += Math.sin(hr) * w * f;
  }
  if (!total || kept < 16) return null;
  var sm = new Array(BINS).fill(0);
  for (var k = 0; k < BINS; k++) {
    var acc = 0, ws = 0;
    for (var d = -2; d <= 2; d++) {
      var kk = (k + d + BINS) % BINS, kw = KERNEL[d + 2];
      acc += mass[kk] * kw; ws += kw;
    }
    sm[k] = acc / ws;
  }
  return { mass: mass, sx: sx, sy: sy, sm: sm, hues: hues, chromas: chromas,
           total: total, kept: kept, seen: seen, R: Math.sqrt(gx*gx + gy*gy) / total };
}

// I candidati sono tutti i massimi locali, non solo il piu' alto: "quale tinta
// occupa piu' spazio" non e' la stessa domanda di "quale colore vedi".
function peaks(st) {
  var out = [];
  for (var b = 0; b < BINS; b++) {
    if (st.sm[b] > st.sm[(b-1+BINS)%BINS] && st.sm[b] >= st.sm[(b+1)%BINS]) out.push(b);
  }
  if (!out.length) {
    var mx = 0;
    for (var q = 1; q < BINS; q++) if (st.sm[q] > st.sm[mx]) mx = q;
    out = [mx];
  }
  return out;
}

function describe(st, bin) {
  var vx = 0, vy = 0, m = 0;
  for (var d = -2; d <= 2; d++) {
    var k = (bin + d + BINS) % BINS;
    vx += st.sx[k]; vy += st.sy[k]; m += st.mass[k];
  }
  var hue = circMeanDeg(vx, vy), band = [];
  for (var i = 0; i < st.hues.length; i++) {
    if (arcDist(st.hues[i], hue) <= 20) band.push([st.chromas[i], st.chromas[i] * st.chromas[i]]);
  }
  band.sort(function (a, b) { return a[0] - b[0]; });
  // croma dell'accento: 75-esimo percentile della sua banda pesato sul quadrato
  // della croma, non la media. Una macchia accesa non viene cosi' annacquata
  // dai pixel slavati che condividono la sua tinta.
  return { hue: hue, chroma: percentile(band, 0.75), share: m / st.total,
           area: band.length / st.seen };
}

// Tre domande, non una.
//
// A — c'e' un colore che si vede? (croma >= 0.025) Fra i picchi si sceglie
//     pesando l'estensione con la carica: un fondo verde smorto esteso su meta'
//     foto batte per massa il bagliore arancione che l'occhio guarda per primo,
//     e non deve vincere (vividness: 0 = vince l'estensione, 1.5 = un colore
//     due volte piu' carico vale quasi tre volte l'area).
//
// B — il fondo ha una tinta? Si riguarda l'immagine accettando anche le
//     velature (croma >= 0.008) e si chiede se TUTTA la foto concorda su una
//     tinta sola. Una foto desaturata o una palette Nord rispondono di si'
//     (R ~ 0.99); un bianco e nero no, perche' la sua poca croma e' rumore di
//     compressione sparso a caso (R ~ 0.2).
//
// C — se il wallpaper e' piatto (meno dell'1% ha colore vero) ma dentro c'e'
//     qualche macchia accesa, quelle macchie si rileggono a risoluzione piu'
//     alta: a 96x96 i quattro pallini di un logo sono cinque pixel in croce, e
//     su cinque pixel non si decide il tema di una scrivania.
//
// Da come rispondono escono quattro esiti: un colore solo, due toni (fondo per
// i pannelli, macchia per l'accento), una velatura sola, o la scala di grigi.
// Rosso e magenta, su un cruscotto scuro, si leggono come un allarme: quando
// l'accento viene da una macchia di trenta pixel non vale la pena far sembrare
// la scrivania in avaria. Se pero' la macchia rossa e' l'unica cosa colorata
// che c'e', rosso sia. Nel percorso normale -- un rosso che riempie la foto,
// l'auto nel garage -- questa regola non entra: li' il rosso e' la foto.
function isAlarmHue(okHue, chroma) {
  var h = okHueToHslHue(okHue, Math.max(chroma, 0.06));
  return h >= 340 || h <= 20;
}

function accentOf(st, vividness, minArea, avoidAlarm) {
  var best = null, bestAlarm = null;
  peaks(st).forEach(function (bin) {
    var c = describe(st, bin);
    if (c.share < 0.05 || c.chroma < 0.03) return;
    // Una manciata di pixel non ridipinge la scrivania: sotto la soglia di area
    // un colore vale solo se e' l'unico che c'e'.
    if (c.area < minArea && c.share < 0.6) return;
    c.score = c.share * Math.pow(c.chroma / CHROMA_REF, vividness);
    if (avoidAlarm && isAlarmHue(c.hue, c.chroma)) {
      if (!bestAlarm || c.score > bestAlarm.score) bestAlarm = c;
      return;
    }
    if (!best || c.score > best.score) best = c;
  });
  return best || bestAlarm;
}

// Il soggetto di un wallpaper piatto puo' non avere colore: una scritta bianca,
// un logo chiaro. E' la cosa che l'occhio guarda per prima, e un istogramma di
// tinte non la vede, perche' il bianco non ha tinta. Si riconosce dal contrasto
// di luminosita': pochi pixel, neutri, molto piu' chiari del resto.
function lightSubject(px, W, H) {
  var Ls = [], light = 0, lightL = 0, n = 0;
  for (var y = 0; y < H; y++) for (var x = 0; x < W; x++) {
    var p = (y * W + x) * 3, lab = oklab(px[p], px[p+1], px[p+2]);
    var C = Math.sqrt(lab[1]*lab[1] + lab[2]*lab[2]);
    n++; Ls.push(lab[0]);
    if (C < 0.03 && lab[0] > 0.72) { light++; lightL += lab[0]; }
  }
  if (!n || !light) return null;
  Ls.sort(function (a, b) { return a - b; });
  var frac = light / n, mean = lightL / light, median = Ls[Math.floor(n / 2)];
  // Fra lo 0.2% e il 10%: meno e' rumore, piu' e' il fondo stesso, non un
  // soggetto. E deve staccare di netto dal resto dell'immagine.
  if (frac < 0.002 || frac > 0.10 || mean - median < 0.35) return null;
  return { frac: frac, lightness: mean, contrast: mean - median };
}

function fieldOf(px, W, H) {
  var st = collect(px, W, H, 0.008);
  if (!st || st.R < 0.9) return null;
  var top = peaks(st).map(function (b) { return describe(st, b); })
                     .sort(function (a, b) { return b.share - a.share; })[0];
  if (!top || top.chroma < 0.020 || top.share < 0.5) return null;
  top.R = st.R;
  return top;
}

// loadHi: funzione che rilegge il wallpaper piu' fitto, chiamata solo se serve
function decide(px, W, H, vividness, loadHi, twoTone) {
  var strong = collect(px, W, H, 0.025);
  var colour = strong ? accentOf(strong, vividness, 0.0025, false) : null;
  var flat   = !strong || strong.kept / strong.seen < 0.01;

  // Immagine con del colore vero: decide lui, come sempre.
  if (colour && !flat) return { accent: colour, field: null, subject: null, mode: 'colore' };

  var field   = flat ? fieldOf(px, W, H) : null;
  var subject = flat ? lightSubject(px, W, H) : null;

  // Wallpaper piatto: le macchie si guardano da vicino prima di dargli retta.
  var speck = null;
  if (flat) {
    var hi = loadHi();
    if (hi) {
      // Soglia di croma alzata a 0.05: per scavalcare il fondo una macchia deve
      // essere accesa davvero, non solo diversa. Senza, l'alone di pixel
      // intermedi attorno alla macchia piu' vicina alla tinta del fondo la fa
      // sembrare grande il quadruplo delle altre, e vince per quello.
      var st = collect(hi.px, hi.w, hi.h, 0.05);
      // 0.02% di 256x256 sono una ventina di pixel: pochi, ma a questa
      // risoluzione sono un campione, non un artefatto del ridimensionamento.
      if (st) speck = accentOf(st, vividness, 0.0002, true);
    }
  }
  if (!speck) speck = colour;

  // Fondo piatto + soggetto chiaro: e' la composizione di un poster. I segni in
  // primo piano prendono il chiaro quasi neutro della scritta, i pannelli la
  // tinta del fondo, e una macchia -- se c'e' e non e' un allarme -- si tiene
  // il solo accento. E' quello che si vede guardando il wallpaper: bianco su
  // fondo, piu' un tocco.
  if (field && subject)
    return { accent: speck, field: field, subject: subject, mode: speck ? 'scritta' : 'scritta piana' };

  if (field && speck && twoTone) return { accent: speck, field: field, subject: null, mode: 'due toni' };
  if (field && !speck)           return { accent: null,  field: field, subject: null, mode: 'velatura' };
  if (field && speck)            return { accent: speck, field: null,  subject: null, mode: 'colore' };
  if (speck)                     return { accent: speck, field: null,  subject: null, mode: 'colore' };
  var quiet = fieldOf(px, W, H);
  if (quiet) {
    // Anche qui il soggetto chiaro conta: una foto con poco colore ma una
    // scritta bianca sopra resta un poster, non una velatura e basta.
    var subj = lightSubject(px, W, H);
    return { accent: null, field: quiet, subject: subj,
             mode: subj ? 'scritta piana' : 'velatura' };
  }
  return { accent: null, field: null, subject: null, mode: 'grigi' };
}

// Miscela verso la tinta base lungo l'arco corto: con BLEND = 0.3 un wallpaper
// verde sposta il blu di qualche decina di gradi invece di sostituirlo.
function blendHue(from, to, t) {
  var d = ((to - from + 540) % 360) - 180;
  return ((from + d * t) % 360 + 360) % 360;
}

var img = SRC ? loadPixels(SRC, SIDE) : null;
if (!img) {
  // Niente stdout: chi ci chiama tiene la palette precedente, e i widget hanno
  // comunque il colore originale come fallback nel CSS.
  err('cosmoduck-theme: immagine non leggibile: ' + SRC);
  $.exit(1);
}

var res = decide(img.px, img.w, img.h, Math.max(VIVIDNESS, 0),
                 function () { return loadPixels(SRC, SIDE_HI); }, TWO_TONE);

// Sotto croma bassa la conversione della tinta va fatta su un colore ben
// quantizzato, o a 8 bit il tono si sposta di parecchi gradi.
function hueOf(c) {
  return blendHue(BASE_HUE, okHueToHslHue(c.hue, Math.max(c.chroma, 0.06)), clamp(BLEND, 0, 1));
}
// La scala segue la radice del rapporto di croma: fra pavimento e soffitto c'e'
// poco spazio, e senza compressione meta' dei wallpaper ci finirebbe appiccicata.
function scaleOf(c) {
  var v = clamp(Math.sqrt(c.chroma / CHROMA_REF), SAT_FLOOR, SAT_CAP);
  return 1 + (v - 1) * clamp(BLEND, 0, 1);
}

var accentHue = null, accentScale = null, fieldHue = null, fieldScale = null;
if (res.accent) { accentHue = hueOf(res.accent); accentScale = scaleOf(res.accent); }
if (res.field)  { fieldHue  = hueOf(res.field);  fieldScale  = scaleOf(res.field); }

if (accentHue === null && fieldHue === null) {
  // Senza tinta si scende sotto il pavimento fino al grigio: il pavimento serve
  // a non spegnere un colore che c'e', non a inventarne uno che non c'e'.
  accentHue = fieldHue = BASE_HUE;
  accentScale = fieldScale = 1 + (GREY_SAT - 1) * clamp(BLEND, 0, 1);
} else if (accentHue === null) {
  accentHue = fieldHue;  accentScale = fieldScale;
} else if (fieldHue === null) {
  fieldHue = accentHue;  fieldScale = accentScale;
}

// Chi prende la tinta dell'accento e chi quella del fondo. I primi sono i segni
// in primo piano -- numeri, icone, archi, bordi -- i secondi sono il supporto:
// vetro, inchiostro, ombre.
var ACCENT_ROLES = { accent: true, bright: true, mid: true, deep: true };
// Col soggetto chiaro i ruoli diventano tre: l'accento vero e proprio resta
// alla macchia, mentre i segni di contorno e il testo si schiariscono fino al
// neutro, che e' il colore della scritta sul wallpaper.
var LETTER_ROLES = { bright: true, mid: true, text: true };
var LETTER_SAT   = 0.25;     // quanto resta della saturazione originale

var c = {};
Object.keys(TEMA).forEach(function (role) {
  var h, sc;
  if (res.subject && LETTER_ROLES[role]) { h = fieldHue;  sc = fieldScale * LETTER_SAT; }
  else if (ACCENT_ROLES[role])           { h = accentHue; sc = accentScale; }
  else                                   { h = fieldHue;  sc = fieldScale; }
  c[role] = hslToRgb(h + TEMA[role][2], clamp(TEMA[role][0] * sc, 0.05, 0.95), TEMA[role][1]);
});

out(JSON.stringify({
  source: SRC,
  mode: res.mode,
  hue: Math.round(accentHue),
  fieldHue: Math.round(fieldHue),
  satScale: +accentScale.toFixed(3),
  fieldScale: +fieldScale.toFixed(3),
  accent: res.accent ? { chroma: +res.accent.chroma.toFixed(3),
                         area: +(res.accent.area * 100).toFixed(2),
                         share: +res.accent.share.toFixed(2) } : null,
  field: res.field ? { chroma: +res.field.chroma.toFixed(3),
                       agreement: +res.field.R.toFixed(2) } : null,
  subject: res.subject ? { area: +(res.subject.frac * 100).toFixed(2),
                           lightness: +res.subject.lightness.toFixed(2),
                           contrast: +res.subject.contrast.toFixed(2) } : null,
  vars: {
    '--cd-accent':     hex(c.accent),
    '--cd-bright':     hex(c.bright),
    '--cd-mid':        hex(c.mid),
    '--cd-deep':       hex(c.deep),
    '--cd-shadow':     hex(c.shadow),
    '--cd-text':       hex(c.text),
    '--cd-ink':        hex(c.ink),
    '--cd-glass':      rgba(c.glass, 0.55),
    '--cd-border':     rgba(c.accent, 0.22),
    '--cd-fill':       rgba(c.accent, 0.18),
    '--cd-rule':       rgba(c.accent, 0.14),
    '--cd-rule-faint': rgba(c.accent, 0.12),
    '--cd-track':      rgba(c.shadow, 0.55)
  }
}));
